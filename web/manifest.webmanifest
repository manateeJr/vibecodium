{
  "name": "Vibecodium",
  "short_name": "vibecodium",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#06130d",
  "theme_color": "#06130d",
  "share_target": {
    "action": "/share-intake",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "project",
      "text": "note",
      "files": [
        {
          "name": "file",
          "accept": [
            "*/*",
            "image/*",
            "video/*",
            "audio/*",
            "text/*",
            "application/pdf",
            "application/json",
            "application/zip"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
