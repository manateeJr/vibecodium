# Token issued by Telegram BotFather.
VIBECODIUM_TELEGRAM_TOKEN=123456789:replace-with-bot-token
# Numeric Telegram user id allowed to control this bot.
VIBECODIUM_TELEGRAM_USER_ID=123456789
# Numeric id of the private Telegram supergroup.
VIBECODIUM_TELEGRAM_CHAT_ID=-1001234567890
# Control-plane loopback URL.
VIBECODIUM_URL=http://127.0.0.1:4310
# SQLite path for topic bindings and update offsets.
VIBECODIUM_TELEGRAM_DB_PATH=.vibecodium/telegram.sqlite
# Telegram Bot API base URL; leave unchanged for production.
VIBECODIUM_TELEGRAM_API_BASE=https://api.telegram.org
