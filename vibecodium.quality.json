{
  "profile": "strict",
  "maxFileLines": 500,
  "maxFileLinesExempt": [
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "dist/**",
    "node_modules/**",
    ".vibecodium/evidence/**"
  ],
  "format": "npm run format:check",
  "lint": "npm run lint",
  "typecheck": "npm run typecheck",
  "test": "npm test",
  "gate": "npm run gate",
  "hooks": {
    "pre_commit": "staged format + lint + secret scan + issue-link + max-file-lines checks",
    "pre_push": "npm run gate"
  },
  "evidence_directory": ".vibecodium/evidence"
}
